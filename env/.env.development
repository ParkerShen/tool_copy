# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false

# VITE_SERVER_BASEURL = 'https://sit-api.guardforceai.cn'

VITE_BASE_OSS = 'https://innoai-01.oss-cn-shenzhen.aliyuncs.com'

VITE_ENV_FILE = '.env.development'

# 代理前缀
VITE_APP_BASE_API_LOGIN = '/passport'
VITE_APP_BASE_API_LANGUAGE = '/language'
VITE_APP_BASE_API_LOG = '/log'
VITE_APP_BASE_API_RESOURCE = '/resource'
VITE_APP_BASE_API_DOWNLOAD = '/download'
VITE_APP_BASE_API_PUSH = '/push'
VITE_APP_BASE_API_USER = '/user'
VITE_APP_BASE_API_COUPON = '/coupon'
VITE_APP_BASE_API_CONFIG = '/config'
VITE_APP_BASE_API_ACTIVITY = '/activity'
VITE_APP_BASE_API_QRCODE = '/qr_code'
VITE_APP_BASE_API_APPMOBILE = '/a-mobile'

# 线上接口地址
# VITE_APP_API_URL = http://vapi.youlai.tech
VITE_APP_API_URL = http://localhost:3001
