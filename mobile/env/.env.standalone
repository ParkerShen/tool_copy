# 本地全栈模式：接口逻辑 + SQLite 数据库全部运行在 H5 页面内
NODE_ENV = 'production'

# local = 使用页面内 SQLite；server = 访问远程 serveradmin
VITE_DATA_MODE = 'local'

# 是否去除 console 和 debugger
VITE_DELETE_CONSOLE = false

# 本地模式不访问远程接口
VITE_SERVER_BASEURL = ''

# OSS 地址仅用于未使用的旧页面，保留以免打包时替换成 undefined
VITE_BASE_OSS = 'https://innoai-01.oss-cn-shenzhen.aliyuncs.com'
VITE_BASE_OSS_API = 'https://innoai-01.oss-cn-shenzhen.aliyuncs.com'

VITE_APP_TITLE = '本地记账'
VITE_APP_PUBLIC_BASE = '/'
VITE_FALLBACK_LOCALE = 'zh-Hans'

VITE_ENV_FILE = '.env.standalone'
