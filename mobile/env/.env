VITE_APP_TITLE = '本地记账'

# 数据模式：server = 远程接口；local = 页面内 SQLite（standalone 构建覆盖）
VITE_DATA_MODE = 'server'
VITE_APP_PORT = 9000

# github actions 部署地址根路径，用在 manifest.config.ts 里面的 h5.router.base
VITE_APP_PUBLIC_BASE=/

# TODO: 记得修改
VITE_UNI_APPID = ''
VITE_WX_APPID = 'wx3605c26bede6b509'

# fallback lacale：en, zh-Hans, zh-Hant 等
# 必须要在 lacale 文件夹中配置对应的 json 文件！！！
# 参考文档如下
# https://uniapp.dcloud.net.cn/tutorial/i18n.html
# https://uniapp.dcloud.net.cn/api/ui/locale.html#onlocalechange 打开页面后最下面的注意事项
VITE_FALLBACK_LOCALE = 'zh-Hans'

VITE_SERVER_BASEURL = ''

VITE_ENV_FILE = '.env'

# 日记邮件通知（EmailJS）
# 在 EmailJS 后台连接 163 邮箱的 SMTP 后，把下面的 ID/Key 填上；留空则不发邮件
VITE_DIARY_MAIL_SERVICE_ID = 'service_y2ice8w'
VITE_DIARY_MAIL_TEMPLATE_ID = 'template_avcxgwh'
VITE_DIARY_MAIL_PUBLIC_KEY = 'IiDfWoz2UGtVP8rES'
